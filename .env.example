# =============================================================================
# VARIABLES DE ENTORNO — BODEGAS DEL ATUEL
# =============================================================================

# Configuración del motor PostgreSQL (Superuser para migraciones e inicialización)
POSTGRES_USER=admin_atuel
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=bodegas_atuel
POSTGRES_PORT=5432

# Configuración de Conexión de la API (Rol de lectura/escritura sin privilegios de propietario)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodegas_atuel
DB_USER=operador_atuel
DB_PASSWORD=operador_pass
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Configuración de la API REST
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
